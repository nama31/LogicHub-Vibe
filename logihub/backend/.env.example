# ─── Database ────────────────────────────────────────────────────────────────
# Local dev: uses Docker Compose service name "db"
# Production (Supabase): postgresql+asyncpg://postgres.[ref]:[password]@pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://logihub:your_db_password@db:5432/logihub
DB_PASSWORD=your_strong_password_here

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=your-32-char-secret-here
BOT_SECRET=your-bot-secret-here

# ─── Telegram Bot ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-bot-token-from-@BotFather
# Local: http://backend:8000 (Docker Compose service name)
# Production: https://logihub-backend-xxxxx.ondigitalocean.app
BACKEND_URL=http://backend:8000

# ─── Redis ────────────────────────────────────────────────────────────────────
# Local dev: redis://redis:6379 (Docker Compose service name)
# Production (Upstash free): rediss://default:<token>@<host>:6379
REDIS_URL=redis://redis:6379

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Production: set to your DO App Platform frontend URL.
CORS_ORIGINS=http://localhost:3000

# ─── WhatsApp (optional) ──────────────────────────────────────────────────────
WHATSAPP_API_URL=https://api.whatsapp.provider.com/v1/messages
WHATSAPP_API_TOKEN=your-whatsapp-token-here