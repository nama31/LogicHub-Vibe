FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app/backend

# Install system dependencies if required (e.g., for psycopg2 or asyncpg compilation)
RUN apt-get update && apt-get install -y --no-install-recommends gcc libpq-dev && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . /app/backend

RUN chmod +x start.sh

# Create non-root user and change ownership
RUN groupadd -r logihub && useradd -r -g logihub logihub && \
    chown -R logihub:logihub /app/backend

# Switch to non-root user
USER logihub

# Healthcheck to ensure API is responsive
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

EXPOSE 8000

CMD ["./start.sh"]
