{$DOMAIN} {
    # Compress responses
    encode zstd gzip

    # Route WebSocket requests
    handle /ws/* {
        reverse_proxy backend:8000
    }

    # Route API requests to backend
    # handle_path strips the matched path before passing it
    handle_path /api/* {
        reverse_proxy backend:8000
    }

    # Route all other requests to the frontend Next.js app
    handle {
        reverse_proxy frontend:3000
    }

    # Logging
    log {
        output stdout
        format json
    }
}
